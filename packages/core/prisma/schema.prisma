// Boots 'n' Bandit — Prisma schema (Phase 2: Data Layer)
// Full domain model per master plan Context section.
// Money is stored as integer pence (GBP). No payment gateway.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ARTIST
  OWNER
}

enum ArtistStatus {
  CO_OWNER
  RESIDENT
  APPRENTICE
}

enum BooksStatus {
  open
  limited
  closed
}

enum BookingType {
  consult
  session
  flash
}

enum BookingStatus {
  enquiry
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum EnquiryStatus {
  new
  replied
  customer_replied
  converted
  closed
}

enum EnquirySource {
  web
  flash
  inkling
}

// Originating channel of an enquiry (superset of EnquirySource, which stays
// as the legacy web/flash/inkling form marker).
enum EnquiryChannel {
  web
  flash
  inkling
  email
  messenger
  instagram
}

enum MessageDirection {
  inbound
  outbound
  internal
}

enum MessageChannelKind {
  web
  email
  messenger
  instagram
  note
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum FlashStatus {
  available
  claimed
  retired
}

enum MessageType {
  confirmation
  reminder
  receipt
  aftercare
  review_request
  enquiry_ack
  enquiry_alert
  loyalty_reward
  staff_invite
  staff_reply
  welcome
}

enum MessageChannel {
  email
  sms
}

enum MessageStatus {
  queued
  sent
  failed
  logged
}

enum ReviewStatus {
  pending
  submitted
  published
  hidden
}

// ---------------------------------------------------------------------------
// Auth / staff
// ---------------------------------------------------------------------------

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  role        Role     @default(ARTIST)
  displayName String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authenticators  Authenticator[]
  artist          Artist?
  enquiryMessages EnquiryMessage[]
  enquiryReads    EnquiryRead[]

  @@index([role])
}

// Short-lived WebAuthn challenge store (registration + authentication).
// Rows are created when options are generated and consumed (deleted) on verify.
// `userId` is set for registration (enrolment) flows; null for the email-first
// authentication flow where the challenge is keyed by handle instead.
enum WebAuthnCeremony {
  registration
  authentication
}

model WebAuthnChallenge {
  id        String           @id @default(cuid())
  handle    String           @unique // opaque cookie id tying browser to challenge
  challenge String // base64url challenge issued to the browser
  ceremony  WebAuthnCeremony
  userId    String? // set for registration; the user enrolling a passkey
  email     String? // set for authentication; the email being signed in
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([expiresAt])
}

// Owner-minted staff invite. Token only — Phase 11 sends the email. Redeeming
// the token lets the invitee enrol their first passkey for the linked user.
model StaffInvite {
  id         String    @id @default(cuid())
  token      String    @unique
  email      String
  role       Role      @default(ARTIST)
  userId     String? // user created/linked when the invite is minted
  expiresAt  DateTime
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

// WebAuthn credential (one user may have many passkeys)
model Authenticator {
  id                  String    @id @default(cuid())
  userId              String
  credentialID        String    @unique
  credentialPublicKey Bytes
  counter             BigInt    @default(0)
  transports          String[]  @default([])
  deviceName          String?
  createdAt           DateTime  @default(now())
  lastUsedAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Artists
// ---------------------------------------------------------------------------

model Artist {
  id              String        @id @default(cuid())
  slug            String        @unique
  userId          String        @unique
  name            String
  status          ArtistStatus  @default(RESIDENT)
  tag             String?
  bio             String?
  styles          TattooStyle[]
  specials        String[]      @default([])
  hue             String?
  hourlyRatePence Int?
  dayRatePence    Int?
  insta           String?
  headshot        String?
  experience      String?
  rating          Float?
  pieces          Int?
  booksStatus     BooksStatus   @default(open)
  sortOrder       Int           @default(0)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  galleryItems      GalleryItem[]
  flashes           Flash[]
  enquiries         Enquiry[]
  bookings          Booking[]
  availabilityRules AvailabilityRule[]
  leave             Leave[]
  calendarFeed      CalendarFeed?
  staffCheckins     StaffCheckin[]

  @@index([booksStatus])
  @@index([sortOrder])
}

// ---------------------------------------------------------------------------
// Customers / CRM
// ---------------------------------------------------------------------------

model Customer {
  id               String    @id @default(cuid())
  name             String
  email            String?   @unique
  phone            String?   @unique
  dob              DateTime?
  passwordHash     String?
  notes            String?
  marketingConsent Boolean   @default(false)
  loyaltyStamps    Int       @default(0)
  loyaltyTier      Int       @default(0)
  tags             String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  enquiries       Enquiry[]
  bookings        Booking[]
  messages        MessageLog[]
  reviews         Review[]
  passwordTokens  CustomerPasswordToken[]
  identities      CustomerIdentity[]
  enquiryMessages EnquiryMessage[]
}

// One-time set-password (account activation) token emailed to a customer.
// 30-day expiry; using an expired link mints a fresh token and re-sends.
model CustomerPasswordToken {
  id         String    @id @default(cuid())
  customerId String
  token      String    @unique
  expiresAt  DateTime
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Enquiries (lead capture)
// ---------------------------------------------------------------------------

model Enquiry {
  id                String         @id @default(cuid())
  customerId        String?
  contactName       String
  contactEmail      String?
  contactPhone      String?
  preferredArtistId String?
  style             String?
  placement         String?
  size              String?
  budgetPence       Int?
  description       String?
  moodboard         String[]       @default([])
  matchData         Json?
  moodboardData     Json?
  status            EnquiryStatus  @default(new)
  source            EnquirySource  @default(web)
  channel           EnquiryChannel @default(web)
  subject           String?
  threadToken       String         @unique @default(cuid())
  lastMessageAt     DateTime?
  lastInboundAt     DateTime?
  assignedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  preferredArtist Artist?          @relation(fields: [preferredArtistId], references: [id], onDelete: SetNull)
  bookings        Booking[]
  moodboardAssets MoodboardAsset[]
  messages        EnquiryMessage[]
  reads           EnquiryRead[]

  @@index([status])
  @@index([source])
  @@index([customerId])
  @@index([preferredArtistId])
  @@index([lastMessageAt])
  @@index([channel])
}

model MoodboardAsset {
  id        String   @id @default(cuid())
  enquiryId String?
  mime      String
  size      Int
  bytes     Bytes
  createdAt DateTime @default(now())

  enquiry Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@index([createdAt])
}

// CMS images (gallery / flash / styles / artist headshots) uploaded through the
// admin ImageUploader. Stored as bytea because web + admin are separate
// containers with ephemeral disks; served publicly at /media/[id] by both.
model MediaAsset {
  id        String   @id @default(cuid())
  mime      String
  size      Int
  bytes     Bytes
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Enquiry threads (omnichannel inbox)
// ---------------------------------------------------------------------------

// One message on an enquiry thread: inbound from the customer, outbound from
// staff, or an internal note never sent anywhere. `externalId` is the
// provider's id (Resend email id / Meta mid) and is unique so webhook retries
// are idempotent.
model EnquiryMessage {
  id              String             @id @default(cuid())
  enquiryId       String
  customerId      String?
  direction       MessageDirection
  channel         MessageChannelKind
  authorUserId    String?
  fromName        String?
  fromAddress     String?
  subject         String?
  bodyText        String
  bodyHtml        String?
  externalId      String?            @unique
  // RFC 5322 Message-ID of an inbound email, kept so an outbound reply can
  // set In-Reply-To/References and land in the customer's own mail thread.
  // `externalId` holds the provider's id (a Resend email id) — a different
  // thing, and not a valid value for those headers.
  messageIdHeader String?
  // Did the receiving MTA authenticate the sender (DMARC, or SPF+DKIM)?
  // null = unknown, which is what every web and Meta message records: those
  // channels authenticate the account, not a header. Never used to drop mail.
  senderVerified  Boolean?
  // The Meta Page/IG connection this message arrived on (or went out on).
  // A reply has to reach the SAME page the customer wrote to, and a customer
  // can move channels inside one thread — so the routing fact belongs to the
  // message, not the enquiry.
  connectionId    String?
  deliveryStatus  MessageStatus      @default(logged)
  createdAt       DateTime           @default(now())

  enquiry     Enquiry            @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  customer    Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorUser  User?              @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  connection  ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([enquiryId, createdAt])
  @@index([customerId])
  @@index([connectionId])
}

// Generalised asset store for message attachments. Images up to 8 MB are held
// inline as bytes (same reasoning as MoodboardAsset: ephemeral container
// disks); anything larger or non-image keeps a source `url` only.
model Attachment {
  id        String   @id @default(cuid())
  messageId String?
  mime      String
  size      Int
  filename  String?
  bytes     Bytes?
  url       String?
  createdAt DateTime @default(now())

  message EnquiryMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([createdAt])
}

// Per-staff-user read marker. An enquiry is unread for a user when its
// lastInboundAt is later than that user's readAt (or there is no row).
model EnquiryRead {
  enquiryId String
  userId    String
  readAt    DateTime @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([enquiryId, userId])
  @@index([userId])
}

// A customer's handle on a channel that carries no email/phone (Messenger
// PSID, Instagram IGSID). One handle belongs to exactly one customer.
model CustomerIdentity {
  id          String             @id @default(cuid())
  customerId  String
  channel     MessageChannelKind
  externalId  String
  displayName String?
  createdAt   DateTime           @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([customerId])
}

// One connected Meta destination: a Facebook Page (channel = messenger) or
// the Instagram business account linked to it (channel = instagram). Both
// rows carry the SAME encrypted page access token, because Instagram
// Messaging is served by the page's /messages endpoint.
//
//   externalId  what Meta's webhook addresses this row by — the page id for
//               messenger, the IG business account id for instagram (unique)
//   pageId      the Page whose token authorises sends; == externalId for a
//               messenger row, the owning page for an instagram row
//   igAccountId the linked IG business account id, on both rows when there is
//               one (null on a page with no linked professional account)
model ChannelConnection {
  id                  String             @id @default(cuid())
  channel             MessageChannelKind
  externalId          String             @unique
  pageId              String
  igAccountId         String?
  name                String
  // AES-256-GCM, "v1:<iv>:<tag>:<ct>" (services/secrets.ts). NEVER plaintext,
  // never selected onto a page prop, never logged.
  accessToken         String
  active              Boolean            @default(true)
  webhookSubscribedAt DateTime?
  lastEventAt         DateTime?
  connectedAt         DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  messages EnquiryMessage[]

  @@index([channel, active])
  @@index([pageId])
}

// ---------------------------------------------------------------------------
// Bookings + Sessions
// ---------------------------------------------------------------------------

model Booking {
  id                 String        @id @default(cuid())
  customerId         String
  artistId           String
  enquiryId          String?
  type               BookingType
  style              String?
  placement          String?
  start              DateTime
  end                DateTime
  durationMin        Int
  priceEstimatePence Int?
  depositPence       Int?
  status             BookingStatus @default(enquiry)
  notes              String?
  remindersOptIn     Boolean       @default(true)
  cancelRequestedAt  DateTime?
  checkedInAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  artist      Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  enquiry     Enquiry?     @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  session     Session?
  consentForm ConsentForm?
  messages    MessageLog[]
  reviews     Review[]

  @@index([artistId, start])
  @@index([customerId])
  @@index([status])
  @@index([start])
}

// Reception kiosk: digital consent form signed by the customer at check-in.
// Answers are the yes/no medical-history questionnaire (question id → boolean);
// `flagged` marks any needs-review answer so the front desk can have a word
// before the session starts. Signature is a data-URL PNG from the kiosk pad
// (black ink on white).
//
// It is a licensing record, so it must outlive edits to the question set and
// can never vanish with its booking: each form snapshots the exact questions
// and version shown (`@bnb/core/consent`), the customer's printed name and
// date of birth, and which member of staff checked their photo ID. The
// snapshot columns are nullable only because forms signed before they existed
// have none (those were all v1). `onDelete: Restrict` blocks deleting a booking
// (or, through the cascade, an artist or customer) that has a signed form.
//
// v3 replicates the studio's paper form: the client's address, postcode,
// phone and email exactly as given on the form (snapshots — the customer
// record is only backfilled where empty), and the artist's half: ID provided,
// design/placement, the signing artist and their signature. `medicalNotes` is
// the paper's "further details"; `questions` holds the full v3 snapshot
// (medical rows, risks text, statements agreed). The idCheckedBy* columns are
// v2 only and stay for those forms.
model ConsentForm {
  id                  String    @id @default(cuid())
  bookingId           String    @unique
  answers             Json
  flagged             Boolean   @default(false)
  signature           String
  formVersion         Int?
  questions           Json? // v1/v2: [{ id, q, expect, section }]; v3: ConsentSnapshot
  printedName         String?
  dob                 DateTime? @db.Date
  address             String?
  postcode            String?
  phone               String?
  email               String?
  medicalNotes        String?
  photoConsent        Boolean?
  idCheckedBy         String? // staff display name at the time
  idCheckedByArtistId String?
  idCheckedAt         DateTime?
  idProvided          String? // v3: "Passport", "Other: …"
  designPlacement     String?
  artistName          String? // v3: signing artist's display name at the time
  artistId            String?
  artistSignature     String? // v3: PNG data URL, like `signature`
  artistSignedAt      DateTime?
  signedAt            DateTime  @default(now())
  createdAt           DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
}

model Session {
  id                 String    @id @default(cuid())
  bookingId          String    @unique
  completedAt        DateTime  @default(now())
  amountChargedPence Int
  tipPence           Int?
  bankRef            String?
  receiptSentAt      DateTime?
  aftercareSentAt    DateTime?
  reviewRequestAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// Reception kiosk: which artists are on the floor each day. One row per
// artist per calendar day (date is midnight local); checkedOutAt set when they
// tap out again. The board shows checked-in artists as "on the floor".
model StaffCheckin {
  id           String    @id @default(cuid())
  artistId     String
  date         DateTime  @db.Date
  checkedInAt  DateTime  @default(now())
  checkedOutAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Availability / leave
// ---------------------------------------------------------------------------

model AvailabilityRule {
  id        String   @id @default(cuid())
  artistId  String
  weekday   Int // 0=Sun .. 6=Sat
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, weekday])
}

model Leave {
  id        String      @id @default(cuid())
  artistId  String
  startDate DateTime
  endDate   DateTime
  reason    String?
  status    LeaveStatus @default(approved)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, startDate])
}

// ---------------------------------------------------------------------------
// Content (CMS-managed)
// ---------------------------------------------------------------------------

model GalleryItem {
  id        String   @id @default(cuid())
  artistId  String?
  style     String?
  title     String   @unique
  placement String?
  image     String?
  hue       String?
  featured  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artist Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  @@index([artistId])
  @@index([style])
  @@index([sortOrder])
}

model Flash {
  id         String      @id @default(cuid())
  artistId   String?
  title      String      @unique
  image      String?
  hue        String?
  sizeCm     String?
  pricePence Int?
  total      Int         @default(1)
  claimed    Int         @default(0)
  endsAt     DateTime?
  status     FlashStatus @default(available)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  artist Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  @@index([artistId])
  @@index([status])
}

model TattooStyle {
  id        String   @id @default(cuid())
  name      String   @unique
  image     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artists Artist[]

  @@index([sortOrder])
}

model AftercareStage {
  id        String   @id @default(cuid())
  order     Int      @unique
  title     String
  body      String
  hue       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Faq {
  id        String   @id @default(cuid())
  question  String   @unique
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// ---------------------------------------------------------------------------
// Loyalty + site settings (singletons / config)
// ---------------------------------------------------------------------------

model LoyaltyConfig {
  id              String   @id @default(cuid())
  name            String   @unique @default("Bandit Pass")
  stampsPerVisit  Int      @default(1)
  spendPerStamp   Int? // pence per stamp (null = one stamp per piece)
  rewardThreshold Int      @default(8)
  rewardDesc      String?
  expiryMonths    Int?
  perks           Json? // [{ stamps: 2, title, desc }, ...]
  messaging       String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SiteSettings {
  id              String   @id @default(cuid())
  studioName      String   @unique
  addressLine     String?
  city            String?
  county          String?
  postcode        String?
  hoursText       String?
  phone           String?
  email           String?
  licensingText   String?
  facebookUrl     String?
  instagramUrl    String?
  tickerLines     String[] @default([])
  enquiriesOpen   Boolean  @default(true)
  visualDirection String   @default("heritage")
  // Front-desk kiosk staff PIN (4–6 digits), scrypt-hashed. Null = no PIN set:
  // the kiosk falls back to a hold-to-unlock staff gate.
  kioskPinHash    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Messaging / calendar / reviews
// ---------------------------------------------------------------------------

model MessageLog {
  id               String         @id @default(cuid())
  customerId       String?
  relatedBookingId String?
  type             MessageType
  channel          MessageChannel @default(email)
  subject          String?
  body             String?
  status           MessageStatus  @default(logged)
  sentAt           DateTime?
  createdAt        DateTime       @default(now())

  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  relatedBooking Booking?  @relation(fields: [relatedBookingId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([type])
  @@index([relatedBookingId])
}

model CalendarFeed {
  id        String   @id @default(cuid())
  artistId  String   @unique
  token     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
}

model Review {
  id          String       @id @default(cuid())
  bookingId   String?
  customerId  String?
  token       String       @unique
  rating      Int?
  body        String?
  status      ReviewStatus @default(pending)
  requestedAt DateTime     @default(now())
  submittedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([bookingId])
}

// Inbound webhook events we accepted (signature valid) but could not process.
// The whole event body is kept so Studio › Channels can replay it; the route
// itself always answers 200 so the provider does not retry-storm.
model WebhookFailure {
  id         String    @id @default(cuid())
  provider   String
  externalId String?
  payload    Json
  error      String
  createdAt  DateTime  @default(now())
  retriedAt  DateTime?

  @@index([provider, createdAt])
  @@index([externalId])
}
