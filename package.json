{
  "name": "bootsnbandit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w @bnb/web run dev & npm -w @bnb/admin run dev & npm -w @bnb/reception run dev",
    "dev:web": "npm -w @bnb/web run dev",
    "dev:admin": "npm -w @bnb/admin run dev",
    "dev:reception": "npm -w @bnb/reception run dev",
    "build": "npm run db:generate && npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm -w @bnb/core run db:generate",
    "db:migrate": "npm -w @bnb/core run db:migrate",
    "db:push": "npm -w @bnb/core run db:push",
    "db:seed": "npm -w @bnb/core run db:seed",
    "admin:link": "tsx --env-file=.env scripts/admin-link.ts",
    "customers:merge": "tsx --env-file=.env scripts/merge-duplicate-customers.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ical-generator": "^11.0.0",
    "libphonenumber-js": "^1.12.0",
    "lucide-react": "^1.21.0",
    "next": "15.5.19",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.8.1",
    "resend": "^6.14.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.19",
    "prettier": "^3.8.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "prisma": {
    "seed": "tsx packages/core/prisma/seed.ts"
  }
}
