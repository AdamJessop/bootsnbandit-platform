# Public web app (apex / www) environment — bootsnbandit.<domain>.
#
# In dev the shared values load from the root .env; a standalone deploy (e.g. a
# Vercel project rooted at apps/web) must set every var below itself.
#
# The web app serves the public marketing site + public API (enquiries, flash,
# match, reviews) plus CUSTOMER auth (sign-in / set-password). It has NO staff
# auth — passkey sign-in lives ONLY on the admin app. Customer sessions use
# their own distinct, host-only `bb_customer_session` cookie so they can never
# collide with the staff `bb_admin_session` cookie on the admin origin.

# Origin of this app — used for absolute URLs (sitemap, emails, OG metadata)
# and the re-issued set-password links when a customer follows an expired one.
APP_ORIGIN="http://localhost:3000"

# Shared Postgres (same database as the admin app).
DATABASE_URL="postgresql://bootsnbandit:bootsnbandit@localhost:5435/bootsnbandit?schema=public"

# Customer session-cookie encryption secret (min 32 chars). Shared with the
# admin app in dev via the root .env; HKDF derives a customer-specific key, so
# customer and staff tokens stay mutually undecryptable even with one secret.
SESSION_SECRET=""

# Transactional email (Resend) — the enquiry auto-ack and the welcome /
# set-password emails (including the automatic expired-link reissue).
RESEND_API_KEY=""
