# Public web app (apex / www) environment — bootsnbandit.<domain>.
#
# In dev the shared values load from the root .env; a standalone deploy (e.g. a
# Vercel project rooted at apps/web) must set every var below itself.
#
# The web app serves the public marketing site + public API (enquiries, flash,
# match, reviews). It has NO staff auth — passkey sign-in lives ONLY on the
# admin app. If customer-facing auth is added here in the future it MUST use its
# OWN distinct, host-only session cookie (e.g. bb_customer_session) so it can
# never collide with the staff `bb_admin_session` cookie on the admin origin.

# Origin of this app — used for absolute URLs (sitemap, emails, OG metadata).
APP_ORIGIN="http://localhost:3000"

# Shared Postgres (same database as the admin app).
DATABASE_URL="postgresql://bootsnbandit:bootsnbandit@localhost:5435/bootsnbandit?schema=public"

# Transactional email (Resend) — used for the enquiry auto-ack.
RESEND_API_KEY=""
