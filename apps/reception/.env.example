# Reception app (front-desk kiosk PWA) environment — reception.<domain>.
#
# In dev the shared values load from the root .env; a standalone deploy (e.g. a
# Vercel project rooted at apps/reception) must set every var below itself.
# The kiosk is a third origin alongside the public site and the staff admin.

# Shared Postgres (same database as the web + admin apps).
DATABASE_URL="postgresql://bootsnbandit:bootsnbandit@localhost:5435/bootsnbandit?schema=public"

# Session encryption secret (min 32 chars) — must match the other apps so is
# usually the same shared secret.
SESSION_SECRET="change-me-in-production-min-32-chars"

# Transactional email (Resend) — the kiosk checkout sends the receipt +
# aftercare emails through @bnb/core exactly like the admin app.
RESEND_API_KEY=""

# Public marketing-site origin — customer-facing links in emails sent from this
# app (aftercare guide, /review/<token>) must point at the PUBLIC site.
PUBLIC_SITE_ORIGIN="http://localhost:3000"

# WebAuthn / origin — the kiosk lives on reception.<domain>. Staff enrol their
# passkeys on the ADMIN app; for those passkeys to work here too, set RP_ID to
# the REGISTRABLE PARENT domain shared by both apps (e.g. bootsnbandit.tld —
# a passkey's RP ID may be any registrable suffix of the origin). Localhost
# keeps dev frictionless (any port on localhost shares the RP).
RP_ID="localhost"
APP_ORIGIN="http://localhost:3002"

# Kiosk session cookie name — DISTINCT from the admin staff cookie and
# host-only (no Domain= attribute), so it is only ever sent to the reception
# origin (same subdomain-isolation model as the admin app).
SESSION_COOKIE="bb_reception_session"

# Wrong-role / unauthenticated redirects land at the kiosk root ("/").
AUTH_REDIRECT="/"
