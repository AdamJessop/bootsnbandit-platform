# Admin app (staff PWA) environment.
#
# Shared with the monorepo (loaded from the root .env in dev): DATABASE_URL,
# RESEND_API_KEY, CRON_SECRET, SESSION_SECRET. The values below are the
# admin-origin-specific overrides; P4 finalises per-subdomain isolation.

# WebAuthn / origin — the staff PWA lives on admin.<domain>. Localhost keeps dev
# frictionless; in prod set these to the admin subdomain.
RP_ID="localhost"
APP_ORIGIN="http://localhost:3001"

# Staff session cookie name — scoped to the admin origin so the web app never
# accepts it (P4). Defaults to the legacy "bb_session" if unset.
SESSION_COOKIE="bb_session"

# Wrong-role / unauthenticated redirects land at the admin root ("/"); the admin
# app is its own origin so sign-in is /sign-in.
AUTH_REDIRECT="/"
