# Admin app (staff PWA) environment — admin.<domain>.
#
# In dev the shared values load from the root .env; a standalone deploy (e.g. a
# Vercel project rooted at apps/admin) must set every var below itself. The
# RP_ID/SESSION_COOKIE/AUTH_REDIRECT values are the admin-origin-specific
# overrides that isolate staff auth per subdomain (P4).

# Shared Postgres (same database as the web app).
DATABASE_URL="postgresql://bootsnbandit:bootsnbandit@localhost:5435/bootsnbandit?schema=public"

# Session encryption secret (min 32 chars).
SESSION_SECRET="change-me-in-production-min-32-chars"

# Transactional email (Resend) — confirmations, reminders, receipts, aftercare,
# review requests, loyalty rewards, staff replies.
RESEND_API_KEY=""

# CRM cron automations — shared secret the scheduler presents to
# /api/cron/run (header `x-cron-secret` or `Authorization: Bearer <secret>`).
CRON_SECRET="change-me-cron-secret"

# Public marketing-site origin — customer-facing links in emails sent from this
# app (aftercare guide, /review/<token>) must point at the PUBLIC site, not the
# admin origin. In prod: https://bootsnbandit.<tld>.
PUBLIC_SITE_ORIGIN="http://localhost:3000"

# WebAuthn / origin — the staff PWA lives on admin.<domain>. Localhost keeps dev
# frictionless; in prod set RP_ID to the admin subdomain (e.g.
# admin.bootsnbandit.tld) and APP_ORIGIN to its full https origin. NOTE:
# changing RP_ID invalidates existing passkeys — re-enrol (dev: `npm run admin:link`).
RP_ID="localhost"
APP_ORIGIN="http://localhost:3001"

# Staff session cookie name — DISTINCT from any future customer cookie and
# host-only (no Domain= attribute), so it is only ever sent to the admin origin
# and the public web app can never receive it (P4 isolation).
SESSION_COOKIE="bb_admin_session"

# Wrong-role / unauthenticated redirects land at the admin root ("/"); the admin
# app is its own origin so sign-in is /sign-in.
AUTH_REDIRECT="/"
