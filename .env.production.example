# Production environment for docker-compose.prod.yml — set ALL of these in the
# Coolify UI (Environment Variables of the compose resource). Nothing here is
# read at build time; images are domain-agnostic.

# Coolify-managed Postgres resource (internal connection URL). Use the
# internal hostname Coolify shows for the DB so traffic stays on the Docker
# network, e.g. postgresql://user:pass@<coolify-db-host>:5432/bootsnbandit?schema=public
DATABASE_URL=""

# Session encryption secret, min 32 chars, SHARED by all three apps (HKDF
# derives per-audience keys so staff/customer/kiosk tokens stay isolated).
# Generate: openssl rand -base64 48
SESSION_SECRET=""

# Transactional email (Resend). Optional EMAIL_FROM overrides the default
# sender ("Boots 'n' Bandit <hello@bootsnbandit.co.uk>").
RESEND_API_KEY=""
EMAIL_FROM=""

# Inbound + outbound enquiry email. INBOUND_EMAIL_DOMAIN is read by admin AND
# web (the web enquiry ack needs the same reply token); RESEND_WEBHOOK_SECRET
# is admin only, where the webhook lives. INBOUND_EMAIL_DOMAIN is the
# subdomain whose MX points at Resend — it is both the address customers reply
# to (enq-<token>@<domain>) and the domain replies are sent from
# (enquiries@<domain>). RESEND_WEBHOOK_SECRET is the whsec_… signing secret of
# the Resend `email.received` webhook. Both are optional: without them the
# inbound webhook answers 503 and replies fall back to EMAIL_FROM with no
# reply token. Full setup: docs/CHANNELS.md.
INBOUND_EMAIL_DOMAIN=""
RESEND_WEBHOOK_SECRET=""

# Facebook Messenger + Instagram DMs (admin only). All three are optional:
# without them /api/webhooks/meta answers 503, Studio › Channels shows "not
# configured", and enquiry replies fall back to email. META_APP_ID and
# META_APP_SECRET come from the Meta app (developers.facebook.com);
# META_VERIFY_TOKEN is a random string you invent and paste into Meta's webhook
# configuration (openssl rand -hex 32). META_GRAPH_VERSION is optional and
# defaults to v21.0. NOTE: Page access tokens are encrypted with a key derived
# from SESSION_SECRET, which must be at least 32 characters for this to work,
# and rotating it makes stored tokens unreadable (reconnect the Page). Full
# setup, permissions and the App Review checklist: docs/CHANNELS.md.
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_GRAPH_VERSION=""

# Secret the cron sidecar presents to admin /api/cron/run.
# Generate: openssl rand -hex 32
CRON_SECRET=""
# Seconds between cron ticks (default 3600 = hourly).
CRON_INTERVAL_SECONDS="3600"

# Full https origins for the three apps — must match the domains assigned to
# each service in Coolify. WEB_ORIGIN is also where customer-facing email
# links point (PUBLIC_SITE_ORIGIN); ADMIN_ORIGIN is where the owners'
# new-enquiry alert links, and is passed to web as well as admin.
WEB_ORIGIN="https://example.com"
ADMIN_ORIGIN="https://admin.example.com"
RECEPTION_ORIGIN="https://reception.example.com"

# Search indexing for the public site (web only). The site is indexable ONLY
# when PRODUCTION_ORIGIN is set, equals WEB_ORIGIN, and the request arrives on
# that host; otherwise every page is `noindex` and robots.txt answers
# `Disallow: /`. Leave it empty on staging (or set it to the production
# origin — staging's different WEB_ORIGIN still keeps it hidden). On the live
# deploy set it to the production origin, e.g. "https://bootsnbandit.com", or
# the site will stay out of Google.
PRODUCTION_ORIGIN=""

# WebAuthn Relying Party ID: the REGISTRABLE PARENT DOMAIN shared by the
# admin and reception origins (e.g. "example.com" for admin.example.com +
# reception.example.com) so staff passkeys enrolled on admin also work on the
# reception kiosk. WARNING: changing RP_ID invalidates ALL enrolled passkeys.
RP_ID="example.com"

# Inkling mood-board inspiration search — Brave Search image API key
# (api-dashboard.search.brave.com, "Data for Search" plan; 2,000 free
# queries/month). Optional: without it the builder shows studio-gallery
# matches + uploads only. GOOGLE_CSE_KEY/GOOGLE_CSE_CX remain supported as a
# legacy fallback for Google Cloud projects that still have Custom Search
# JSON API access (Google no longer grants it to new projects).
BRAVE_SEARCH_KEY=""
GOOGLE_CSE_KEY=""
GOOGLE_CSE_CX=""
