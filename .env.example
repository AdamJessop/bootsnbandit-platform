# Root (shared) environment for the monorepo.
#
# These values are SHARED by every workspace and loaded in dev via:
#   set -a && . ./.env && set +a
# Per-app overrides (APP_ORIGIN / RP_ID / SESSION_COOKIE / AUTH_REDIRECT) live in
# each app's own .env.example — see apps/web/.env.example and apps/admin/.env.example.

# Database (local dev — matches docker-compose.yml; shared Postgres for both apps)
DATABASE_URL="postgresql://bootsnbandit:bootsnbandit@localhost:5435/bootsnbandit?schema=public"

# Session encryption secret (min 32 chars) — shared signing/encryption key.
SESSION_SECRET="change-me-in-production-min-32-chars"

# Transactional email (Resend).
RESEND_API_KEY=""

# CRM cron automations — shared secret the scheduler presents to
# /api/cron/run on the ADMIN app (header `x-cron-secret` or
# `Authorization: Bearer <secret>`).
CRON_SECRET="change-me-cron-secret"

# Public marketing-site origin — customer-facing links in emails (aftercare
# guide, /review/<token>) point here, never at the admin origin.
PUBLIC_SITE_ORIGIN="http://localhost:3000"

# --- Per-app overrides (dev convenience; see each app's .env.example) ---------
# The admin app (apps/admin) is its own origin (admin.<domain>). In dev it runs
# on :3001 with a DISTINCT, host-only staff session cookie. `npm run admin:link`
# mints an enrolment URL against APP_ORIGIN, so point it at the admin origin:
RP_ID="localhost"
APP_ORIGIN="http://localhost:3001"
SESSION_COOKIE="bb_admin_session"
AUTH_REDIRECT="/"
